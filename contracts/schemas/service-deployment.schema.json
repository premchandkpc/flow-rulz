{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowrulz.dev/schemas/service-deployment.schema.json",
  "title": "FlowRulz Domain Service Deployment",
  "description": "Control-plane contract for a Domain-owned execution Service. This is distinct from subscriber/receiver registration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "domain_id",
    "service_id",
    "revision",
    "active",
    "rulesets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "domain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "service_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Local service identifier within domain_id. Worker routing identity is domain_id/service_id." },
    "revision": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean" },
    "worker_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_replicas": { "type": "integer", "minimum": 0, "default": 1 },
        "max_replicas": { "type": "integer", "minimum": 1, "default": 3 },
        "concurrency": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "rulesets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleset_id", "revision"],
        "properties": {
          "ruleset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "revision": { "type": "integer", "minimum": 1 },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "schema_hash": { "type": "string" }
            }
          }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

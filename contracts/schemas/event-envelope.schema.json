{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flow-rulz.io/schemas/event-envelope-v1.json",
  "title": "FlowRulz Event Envelope",
  "type": "object",
  "required": ["id", "type", "tenant_id", "partition_key", "occurred_at", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z_-]+$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.]*[a-z0-9]$"
    },
    "tenant_id": {
      "description": "Runtime event identity only; never a Domain or Service configuration field.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "partition_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_kind": { "type": "string", "enum": ["event", "command", "effect", "request", "response"] },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_hash": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowrulz.dev/schemas/event-envelope.schema.json",
  "title": "FlowRulz Event Envelope",
  "description": "Stable event identity and payload with an extensible meta object for tenant, partitioning, tracing, and producer-specific metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "occurred_at", "data", "meta"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[0-9A-Za-z_-]+$" },
    "type": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9.]*[a-z0-9]$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_hash": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "data": { "type": ["object", "array", "string", "number", "integer", "boolean", "null"] },
    "meta": {
      "type": "object",
      "description": "Extensible runtime metadata. Known fields are validated; producer-specific fields are preserved and may be added without changing the envelope schema.",
      "required": ["tenant_id", "partition_key"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "partition_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workflow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message_kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "causation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "traceparent": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": true
    }
  }
}

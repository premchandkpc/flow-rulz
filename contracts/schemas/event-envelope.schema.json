{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowrulz.dev/schemas/event-envelope.schema.json",
  "title": "FlowRulz Event Envelope",
  "description": "Runtime event envelope. Runtime identity and extensible event metadata live under meta; Domain configuration contains no tenant or partition fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "occurred_at", "data", "meta"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z_-]+$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.]*[a-z0-9]$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_kind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "schema_hash": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "headers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "meta": {
      "type": "object",
      "description": "Extensible runtime metadata. tenant_id and partition_key are required; future runtime metadata can be added without changing the envelope schema.",
      "required": ["tenant_id", "partition_key"],
      "additionalProperties": true,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "partition_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}

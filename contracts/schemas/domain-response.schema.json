{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowrulz.dev/schemas/domain-response.schema.json",
  "title": "FlowRulz Domain Configuration Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "services", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "service-deployment.schema.json" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

{
  "rule_set": "payment-risk",
  "revision": 2,
  "mode": "first_match",
  "input_contract": {
    "name": "PaymentAuthorized",
    "version": "v1",
    "schema_hash": "6c3240662d5dae05b03dc1639ea99bb8368766d5add6aebaac69bd1ae3ba9b20"
  },
  "rules": [
    {
      "id": "flag-declined-payment",
      "priority": 100,
      "when": { "path": "$.status", "op": "eq", "value": "declined" },
      "then": [
        {
          "emit": {
            "topic": "payments.review",
            "data": { "payment_id": "$.payment_id", "order_id": "$.order_id", "reason": "declined" }
          }
        }
      ]
    }
  ]
}
